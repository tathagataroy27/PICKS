        <div className="full-menu-image">
          <Image
            src={item.image}
            alt={`${item.name} at PICKS Montreal`}
            fill
            sizes="(max-width: 700px) 45vw, 25vw"
          />
        </div>
      )}

      <div className="full-menu-content">
        <div>
          <h3>{item.name}</h3>
          <p>{item.description}</p>
        </div>

        {item.price && <strong>{item.price}</strong>}
      </div>
    </article>
  );
}


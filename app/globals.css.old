@import url("https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:wght@400;500;600;700;800&display=swap");

:root {
  --green: #087f55;
  --green-dark: #064d3b;
  --green-deep: #043c30;
  --green-light: #dff4e9;

  --yellow: #ffd83d;
  --yellow-light: #fff4b8;

  --orange: #ff6816;
  --orange-dark: #e94e00;

  --cream: #fffdf5;
  --white: #ffffff;

  --text: #073b32;
  --muted: #65756f;

  --border: #dce7df;

  --shadow: 0 18px 50px rgba(0, 60, 45, 0.1);

  --radius: 24px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--text);
  font-family: "DM Sans", sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

.container {
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto;
}

/* =================================
   HEADER
================================= */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  height: 82px;
  background: rgba(255, 253, 245, 0.96);
  border-bottom: 1px solid rgba(7, 59, 50, 0.08);
  backdrop-filter: blur(12px);
}

.nav-container {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo-link {
  display: flex;
  align-items: center;
}

.logo {
  width: 68px;
  height: 68px;
  object-fit: contain;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 34px;
  font-weight: 700;
  font-size: 15px;
}

.main-nav a {
  position: relative;
  padding: 31px 0;
  transition: color 0.2s ease;
}

.main-nav a:hover {
  color: var(--green);
}

.main-nav a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 22px;
  height: 3px;
  border-radius: 10px;
  background: var(--green);
  transform: scaleX(0);
  transition: transform 0.2s ease;
}

.main-nav a:hover::after {
  transform: scaleX(1);
}

.nav-order,
.button,
.combo-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border-radius: 999px;
  font-weight: 800;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.nav-order {
  padding: 15px 25px;
  background: var(--orange);
  color: white;
}

.nav-order:hover,
.button:hover,
.combo-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(255, 104, 22, 0.2);
}

/* =================================
   HERO
================================= */

.hero {
  padding: 68px 0 75px;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 80% 20%,
      rgba(255, 216, 61, 0.18),
      transparent 28%
    ),
    var(--cream);
}

.hero-grid {
  display: grid;
  grid-template-columns: 0.92fr 1.08fr;
  align-items: center;
  gap: 55px;
}

.eyebrow {
  color: var(--green);
  font-weight: 800;
  letter-spacing: 0.04em;
  font-size: 17px;
  margin-bottom: 13px;
}

.eyebrow.orange {
  color: var(--orange);
}

.hero h1,
.section-heading h2,
.fusion-header h2,
.visit-info h2 {
  font-family: "Anton", sans-serif;
  font-weight: 400;
  letter-spacing: -0.025em;
  line-height: 0.93;
  margin: 0;
}

.hero h1 {
  font-size: clamp(60px, 6vw, 94px);
  color: var(--green-deep);
}

.hero h1 span,
.section-heading h2 span,
.fusion-header h2 span,
.visit-info h2 span {
  color: var(--green);
}

.hero-text {
  max-width: 530px;
  font-size: 20px;
  line-height: 1.55;
  margin: 25px 0;
  color: #304e46;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.button {
  padding: 16px 25px;
  font-size: 14px;
}

.button-primary {
  color: white;
  background: var(--green);
}

.button-outline {
  color: var(--green);
  border: 2px solid var(--green);
}

.button-orange {
  background: var(--orange);
  color: white;
}

.hero-mini-points {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 28px;
  color: var(--green-dark);
  font-size: 13px;
  font-weight: 700;
}

.hero-image-wrap {
  position: relative;
  min-height: 510px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-yellow-shape {
  position: absolute;
  width: 390px;
  height: 390px;
  right: 4%;
  top: 55px;
  border-radius: 50%;
  background: var(--yellow);
  transform: rotate(-7deg);
}

.hero-yellow-shape::after {
  content: "";
  position: absolute;
  width: 190px;
  height: 60px;
  left: -60px;
  top: 80px;
  background: var(--orange);
  opacity: 0.8;
  transform: rotate(-18deg);
  border-radius: 40%;
}

.hero-image {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 650px;
  height: 490px;
  object-fit: cover;
  border-radius: 28px;
  box-shadow: 0 28px 60px rgba(0, 55, 42, 0.18);
}

.fresh-badge {
  position: absolute;
  right: -5px;
  top: 15px;
  z-index: 4;
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 22px;
  line-height: 1.05;
  text-align: center;
  transform: rotate(-7deg);
  color: var(--green-deep);
}

.fresh-badge strong {
  color: var(--orange);
  font-size: 25px;
}

.fresh-badge span {
  display: block;
  font-family: sans-serif;
  font-size: 32px;
  margin-top: 4px;
}

/* =================================
   COMBO
================================= */

.combo-section {
  padding: 15px 0 80px;
}

.combo-card {
  position: relative;
  min-height: 300px;
  overflow: hidden;
  border-radius: 26px;
  background: var(--green);
  color: white;
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  align-items: center;
  padding: 38px 45px;
}

.combo-copy {
  position: relative;
  z-index: 5;
}

.orange-label {
  display: inline-block;
  background: var(--orange);
  color: white;
  font-size: 13px;
  font-weight: 800;
  padding: 9px 14px;
  border-radius: 7px;
  transform: rotate(-2deg);
}

.combo-price {
  color: var(--yellow);
  font-family: "Anton", sans-serif;
  font-size: 70px;
  line-height: 0.9;
  margin-top: 12px;
}

.combo-copy h2 {
  font-family: "Anton", sans-serif;
  font-size: 38px;
  line-height: 0.9;
  font-weight: 400;
  margin: 4px 0 10px;
}

.combo-copy p {
  margin: 0 0 18px;
  font-weight: 600;
}

.combo-button {
  background: var(--yellow);
  color: var(--green-dark);
  padding: 13px 20px;
  font-size: 13px;
}

.combo-visual {
  position: relative;
  height: 250px;
}

.yellow-circle {
  position: absolute;
  width: 270px;
  height: 270px;
  right: 65px;
  top: -15px;
  border-radius: 50%;
  background: var(--yellow);
}

.combo-fries {
  position: absolute;
  z-index: 3;
  width: 210px;
  height: 210px;
  object-fit: contain;
  right: 155px;
  bottom: -15px;
}

.combo-pop {
  position: absolute;
  z-index: 4;
  width: 80px;
  height: 130px;
  object-fit: contain;
  right: 55px;
  bottom: 20px;
}

.combo-burger {
  position: absolute;
  z-index: 5;
  width: 220px;
  height: 160px;
  object-fit: cover;
  border-radius: 50%;
  left: 10px;
  bottom: 5px;
  border: 6px solid var(--green);
}

.combo-tag {
  position: absolute;
  z-index: 6;
  right: 22px;
  bottom: 12px;
  color: var(--green-dark);
  font-family: Georgia, serif;
  font-style: italic;
  font-weight: 800;
  line-height: 0.9;
  transform: rotate(-5deg);
}

/* =================================
   BUILD SECTION
================================= */

.build-section {
  padding: 95px 0;
  background: white;
}

.section-heading.centered {
  text-align: center;
}

.section-heading h2 {
  font-size: clamp(55px, 6vw, 80px);
  color: var(--green-deep);
}

.section-heading p {
  color: var(--muted);
  font-size: 18px;
  max-width: 650px;
  margin: 22px auto 0;
  line-height: 1.6;
}

.build-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin: 55px 0 28px;
}

.build-step {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px;
  border-radius: 18px;
  background: var(--green-light);
}

.step-number {
  flex: 0 0 46px;
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: white;
  background: var(--green);
  font-weight: 800;
  font-size: 18px;
}

.build-step h3 {
  margin: 0;
  text-transform: uppercase;
  font-size: 15px;
}

.build-step p {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.build-columns {
  display: grid;
  grid-template-columns: 1.25fr 1fr 1fr;
  gap: 18px;
}

.build-panel {
  padding: 25px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: var(--cream);
}

.burger-panel {
  background: var(--green-deep);
  color: white;
}

.panel-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: 800;
  margin-bottom: 16px;
}

.panel-title span {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  background: var(--orange);
  color: white;
  border-radius: 50%;
  font-size: 12px;
}

.burger-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.burger-option {
  padding: 10px;
  text-align: center;
  background: white;
  color: var(--text);
  border-radius: 13px;
}

.burger-option img {
  width: 100%;
  height: 85px;
  object-fit: contain;
}

.burger-option strong {
  display: block;
  font-size: 11px;
}

.burger-option span {
  display: block;
  color: var(--green);
  font-weight: 800;
  font-size: 11px;
  margin-top: 4px;
}

.panel-note {
  margin: -5px 0 15px;
  color: var(--muted);
  font-size: 12px;
}

.ingredient-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.free-item {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 9px;
  background: white;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 700;
}

.free-item > span {
  color: var(--green);
  font-weight: 900;
}

.free-item small {
  margin-left: auto;
  color: var(--green);
  font-size: 8px;
  font-weight: 900;
}

.sauce-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.sauce-grid span {
  padding: 8px 10px;
  border-radius: 999px;
  background: white;
  border: 1px solid var(--border);
  font-size: 11px;
  font-weight: 600;
}

.toppings-area {
  margin-top: 20px;
  padding: 30px;
  background: #fff8d5;
  border-radius: 20px;
  border: 2px dashed #e6c62d;
}

.toppings-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.toppings-header h3 {
  margin: 0;
  font-size: 24px;
}

.charged-badge {
  background: var(--orange);
  color: white;
  font-weight: 800;
  font-size: 11px;
  padding: 8px 12px;
  border-radius: 999px;
}

.paid-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
  margin-top: 20px;
}

.paid-item {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  background: white;
  border-radius: 8px;
  padding: 10px;
  font-size: 11px;
}

.paid-item strong {
  color: var(--orange);
  white-space: nowrap;
}

.build-bottom-message {
  margin-top: 25px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 13px;
  flex-wrap: wrap;
  font-size: 13px;
}

.green-text {
  color: var(--green);
}

/* =================================
   KOREAN FUSION
================================= */

.fusion-section {
  padding: 95px 0;
  background: var(--yellow);
}

.fusion-header {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 50px;
  margin-bottom: 40px;
}

.fusion-header h2 {
  font-size: clamp(60px, 6vw, 82px);
}

.fusion-header p {
  max-width: 420px;
  font-size: 18px;
  line-height: 1.55;
  color: var(--green-dark);
}

.fusion-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.fusion-card {
  overflow: hidden;
  background: var(--cream);
  border-radius: 22px;
  box-shadow: var(--shadow);
}

.fusion-image {
  height: 250px;
  overflow: hidden;
}

.fusion-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.fusion-card:hover .fusion-image img {
  transform: scale(1.05);
}

.fusion-info {
  padding: 22px;
}

.fusion-info > div {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.fusion-info h3 {
  margin: 0;
  font-size: 24px;
}

.fusion-info > div span {
  color: var(--orange);
  font-weight: 800;
}

.fusion-info p {
  color: var(--muted);
  line-height: 1.5;
  font-size: 14px;
  margin-bottom: 0;
}

/* =================================
   BURGERS
================================= */

.burgers-section {
  padding: 95px 0;
  background: var(--cream);
}

.section-heading:not(.centered) {
  margin-bottom: 38px;
}

.section-heading:not(.centered) h2 {
  font-size: clamp(50px, 5vw, 70px);
}

.section-heading:not(.centered) p {
  margin-left: 0;
  max-width: 550px;
}

.burger-card-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
}

.food-card {
  overflow: hidden;
  background: white;
  border: 1px solid var(--border);
  border-radius: 18px;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.food-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow);
}

.food-image {
  height: 190px;
  background: #f7f4e9;
  overflow: hidden;
}

.food-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.food-info {
  padding: 16px;
}

.food-info > div {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 5px;
}

.food-info h3 {
  margin: 0;
  font-size: 16px;
}

.price {
  color: var(--orange);
  font-weight: 800;
  white-space: nowrap;
}

.food-info p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.45;
  margin-bottom: 0;
}

/* =================================
   SIDES
================================= */

.sides-section {
  padding: 90px 0;
  background: white;
}

.favorites-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 15px;
  margin-top: 45px;
}

.favorite-card {
  padding: 10px;
  background: var(--cream);
  border: 1px solid var(--border);
  border-radius: 16px;
  text-align: center;
}

.favorite-image {
  height: 140px;
  overflow: hidden;
  border-radius: 12px;
}

.favorite-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.favorite-card h3 {
  font-size: 13px;
  margin: 12px 0 5px;
}

/* =================================
   MENU
================================= */

.menu-section {
  padding: 100px 0;
  background: var(--green-deep);
  color: white;
}

.menu-section .section-heading h2 {
  color: white;
}

.menu-section .section-heading h2 span {
  color: var(--yellow);
}

.menu-section .section-heading p {
  color: #c2d5ce;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  margin-top: 50px;
}

.menu-box {
  padding: 25px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.menu-box-title {
  display: inline-block;
  background: var(--orange);
  color: white;
  font-weight: 800;
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 13px;
  margin-bottom: 15px;
}

.menu-box-title.second {
  margin-top: 25px;
}

.menu-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 9px 0;
  border-bottom: 1px dashed rgba(255, 255, 255, 0.15);
  font-size: 12px;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-row strong {
  color: var(--yellow);
  white-space: nowrap;
}

.menu-row .free-price {
  color: #66d79e;
}

.menu-sauce-list {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.menu-sauce-list span {
  padding: 7px 9px;
  background: rgba(255, 255, 255, 0.09);
  border-radius: 999px;
  font-size: 10px;
}

.combo-note {
  margin-top: 25px;
  padding: 28px 32px;
  border-radius: 18px;
  background: var(--yellow);
  color: var(--green-dark);
  display: flex;
  align-items: center;
  gap: 25px;
}

.combo-note > div {
  display: flex;
  align-items: center;
  gap: 15px;
  white-space: nowrap;
}

.combo-note > div span {
  font-size: 12px;
  font-weight: 900;
}

.combo-note > div strong {
  font-family: "Anton", sans-serif;
  font-weight: 400;
  font-size: 40px;
  color: var(--green);
}

.combo-note p {
  margin: 0;
  font-weight: 600;
  font-size: 14px;
  flex: 1;
}

/* =================================
   VISIT
================================= */

.visit-section {
  padding: 90px 0;
  background:
    radial-gradient(
      circle at 90% 20%,
      rgba(255, 216, 61, 0.25),
      transparent 25%
    ),
    var(--cream);
}

.visit-grid {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr 0.65fr;
  gap: 45px;
  align-items: center;
}

.visit-brand {
  text-align: center;
}

.visit-brand img {
  width: 125px;
  height: 125px;
  object-fit: contain;
}

.visit-brand h2 {
  font-family: "Anton", sans-serif;
  font-size: 45px;
  font-weight: 400;
  margin: 5px 0;
  color: var(--green);
}

.visit-brand p {
  margin: 0;
  color: var(--muted);
}

.visit-info h2 {
  font-size: 55px;
  margin-bottom: 25px;
}

.location-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.location-details > div {
  padding: 16px;
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
}

.location-details strong {
  display: block;
  font-size: 13px;
}

.location-details span {
  display: block;
  color: var(--muted);
  font-size: 11px;
  margin-top: 5px;
}

.visit-order {
  padding: 30px;
  border-radius: 20px;
  background: var(--green);
  color: white;
  text-align: center;
}

.visit-order > span {
  font-size: 11px;
  font-weight: 800;
  color: var(--yellow);
}

.visit-order h3 {
  font-family: "Anton", sans-serif;
  font-weight: 400;
  font-size: 42px;
  margin: 8px 0 20px;
}

/* =================================
   FOOTER
================================= */

.footer {
  background: #022d24;
  color: #bdd3ca;
  padding: 22px 0;
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  font-size: 12px;
}

/* =================================
   RESPONSIVE
================================= */

@media (max-width: 1050px) {
  .main-nav {
    gap: 18px;
  }

  .main-nav a {
    font-size: 13px;
  }

  .hero-grid {
    gap: 30px;
  }

  .hero h1 {
    font-size: 65px;
  }

  .burger-card-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .favorites-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .menu-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .visit-grid {
    grid-template-columns: 0.6fr 1.4fr;
  }

  .visit-order {
    grid-column: 1 / -1;
  }
}

@media (max-width: 800px) {
  .container {
    width: min(100% - 30px, 650px);
  }

  .site-header {
    height: 70px;
  }

  .logo {
    width: 58px;
    height: 58px;
  }

  .main-nav {
    display: none;
  }

  .nav-order {
    padding: 11px 16px;
    font-size: 11px;
  }

  .hero {
    padding: 45px 0 55px;
  }

  .hero-grid {
    grid-template-columns: 1fr;
  }

  .hero-content {
    text-align: center;
  }

  .hero-text {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-buttons,
  .hero-mini-points {
    justify-content: center;
  }

  .hero-image-wrap {
    min-height: 390px;
  }

  .hero-image {
    height: 350px;
  }

  .hero-yellow-shape {
    width: 300px;
    height: 300px;
  }

  .fresh-badge {
    right: 0;
    top: 0;
    font-size: 17px;
  }

  .combo-card {
    grid-template-columns: 1fr;
    padding: 30px;
  }

  .combo-visual {
    margin-top: 20px;
  }

  .combo-tag {
    display: none;
  }

  .build-steps {
    grid-template-columns: 1fr;
  }

  .build-columns {
    grid-template-columns: 1fr;
  }

  .paid-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .fusion-header {
    display: block;
  }

  .fusion-header p {
    margin-top: 25px;
  }

  .fusion-grid {
    grid-template-columns: 1fr;
  }

  .burger-card-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .favorites-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .menu-grid {
    grid-template-columns: 1fr;
  }

  .combo-note {
    display: block;
  }

  .combo-note > div {
    margin-bottom: 10px;
  }

  .combo-note .button {
    margin-top: 15px;
  }

  .visit-grid {
    grid-template-columns: 1fr;
  }

  .location-details {
    grid-template-columns: 1fr;
  }

  .footer-inner {
    flex-direction: column;
    text-align: center;
  }
}

@media (max-width: 520px) {
  .hero h1 {
    font-size: 54px;
  }

  .section-heading h2,
  .fusion-header h2 {
    font-size: 53px;
  }

  .hero-image-wrap {
    min-height: 300px;
  }

  .hero-image {
    height: 280px;
  }

  .hero-yellow-shape {
    width: 230px;
    height: 230px;
    right: 8%;
  }

  .combo-price {
    font-size: 58px;
  }

  .combo-copy h2 {
    font-size: 32px;
  }

  .burger-options {
    grid-template-columns: 1fr;
  }

  .burger-option {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    align-items: center;
    gap: 8px;
    text-align: left;
  }

  .burger-option img {
    width: 80px;
    height: 60px;
  }

  .paid-grid {
    grid-template-columns: 1fr;
  }

  .burger-card-grid {
    grid-template-columns: 1fr;
  }

  .favorites-grid {
    grid-template-columns: 1fr 1fr;
  }

  .favorite-image {
    height: 120px;
  }

  .combo-visual {
    height: 210px;
  }

  .yellow-circle {
    width: 210px;
    height: 210px;
    right: 10px;
  }

  .combo-fries {
    width: 155px;
    height: 155px;
    right: 75px;
  }

  .combo-pop {
    right: 0;
    width: 60px;
    height: 100px;
  }

  .combo-burger {
    width: 150px;
    height: 110px;
    left: 0;
  }

  .build-bottom-message {
    text-align: center;
  }

  .visit-info h2 {
    font-size: 48px;
  }
}
